# ============================================================
# MailDesk Pro - variables de entorno (copiar a .env y completar)
# NUNCA subir .env al repositorio. Los valores aquí son ejemplos.
# ============================================================

# Perfil de Spring: local (H2, sin PostgreSQL) | dev (PostgreSQL local) | prod
SPRING_PROFILES_ACTIVE=local

# URL pública de la aplicación (se usa en enlaces de invitación/recuperación)
APP_BASE_URL=http://localhost:8080
APP_PORT=8080

# Administrador inicial (único destinatario de sus propias verificaciones)
APP_INITIAL_ADMIN_EMAIL=admin@tu-empresa.com

# Secreto de un solo uso para el alta inicial del administrador (mínimo 16 caracteres).
# scripts/setup.ps1 lo genera automáticamente.
APP_SETUP_SECRET=

# Clave HMAC para los códigos de verificación (mínimo 32 caracteres, aleatoria).
# Debe vivir fuera de la base de datos. scripts/setup.ps1 la genera.
APP_OTP_HMAC_SECRET=

# Carpeta de almacenamiento de adjuntos y logotipo (fuera de recursos públicos)
APP_STORAGE_DIR=./data/storage

# Tiempo de inactividad de sesión
APP_SESSION_TIMEOUT=30m

# ---------------- Base de datos (perfiles dev y prod) ----------------
DB_URL=jdbc:postgresql://localhost:5432/maildesk
DB_USERNAME=maildesk
DB_PASSWORD=cambia-esta-contrasena

# ---------------- Correo saliente (SMTP) ----------------
# La cuenta SMTP es independiente de las cuentas de acceso a la aplicación.
# Consulte docs/GUIA-OPERACION.md. Si su proveedor exige OAuth2 (por ejemplo Microsoft 365
# o Google Workspace con autenticación básica deshabilitada), NO use la contraseña habitual:
# use el método que el proveedor autorice (contraseña de aplicación, relay SMTP autorizado, etc.).
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_STARTTLS=false
MAIL_SSL=false
MAIL_FROM=maildesk@localhost.test
MAIL_FROM_NAME=MailDesk Pro
# true solo cuando el SMTP anterior es un servidor real autorizado
APP_MAIL_REAL=false
MAIL_CONNECT_TIMEOUT_MS=10000
MAIL_READ_TIMEOUT_MS=20000
MAIL_WRITE_TIMEOUT_MS=20000

# Cola de salida
APP_MAIL_CONCURRENCY=2
APP_MAIL_MAX_ATTEMPTS=3
APP_MAIL_QUOTA_PER_USER_PER_DAY=200
APP_MAIL_MAX_RECIPIENTS=50

# Producción tras proxy HTTPS
APP_FORWARD_HEADERS=native
APP_COOKIE_SECURE=true
